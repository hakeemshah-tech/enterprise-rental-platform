#!/usr/bin/env sh
# ──────────────────────────────────────────────────────────────
# Enterprise Rental Platform: pre-commit gate
#   1. Hard-block any real environment file from entering history.
#   2. Run Prettier over staged files via lint-staged.
# ──────────────────────────────────────────────────────────────

# ── 1. Secret guard ───────────────────────────────────────────
# Matches .env, .env.local, .env.production, client/.env.test …
# but deliberately allows *.example templates.
STAGED_ENV_FILES=$(git diff --cached --name-only --diff-filter=ACMR |
  grep -E '(^|/)\.env($|\.)' |
  grep -v -E '\.example$' || true)

if [ -n "$STAGED_ENV_FILES" ]; then
  echo ""
  echo "✖ COMMIT BLOCKED - environment file(s) staged:"
  echo "$STAGED_ENV_FILES" | sed 's/^/    /'
  echo ""
  echo "  These files hold credentials and must never be committed."
  echo "  Unstage them:   git restore --staged <file>"
  echo "  Need a template? Update the tracked .env.example instead."
  echo ""
  exit 1
fi

# ── 2. Formatting ─────────────────────────────────────────────
# Formats only what is staged, so the repository is adopted
# incrementally instead of in one sweeping rewrite.
if [ -x "node_modules/.bin/lint-staged" ]; then
  npx --no-install lint-staged
else
  echo "⚠ lint-staged not installed, skipping format step. Run: npm install"
fi
