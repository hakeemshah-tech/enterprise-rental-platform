{
  "semi": true,
  "singleQuote": true,
  "trailingComma": "es5",
  "printWidth": 100,
  "tabWidth": 2,
  "endOfLine": "lf",
  "overrides": [
    {
      "files": "client/**/*.{ts,tsx}",
      "options": {
        "tabWidth": 4
      }
    },
    {
      "files": "*.{json,yml,yaml,md}",
      "options": {
        "singleQuote": false
      }
    }
  ]
}
