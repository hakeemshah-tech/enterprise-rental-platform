# ──────────────────────────────────────────────────────────────
# Enterprise Rental Platform: Next.js client (presentation layer)
# Copy to `.env.local` and fill in. NEVER commit `.env.local`.
# ──────────────────────────────────────────────────────────────

# Base URL of the Property API (Node.js/Express BFF).
# Anything prefixed NEXT_PUBLIC_* is inlined into the browser bundle;
# only put non-secret values here.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Canonical site origin, used for metadataBase / sitemap / robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
