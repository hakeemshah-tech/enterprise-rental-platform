{
  "name": "enterprise-rental-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Rental Platform: Next.js presentation layer + Node.js Property API, orchestrated as a single npm workspace.",
  "author": "Hakeem Shah <hakeemshah.tech@outlook.com>",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hakeemshah-tech/enterprise-rental-platform.git"
  },
  "homepage": "https://github.com/hakeemshah-tech/enterprise-rental-platform#readme",
  "bugs": {
    "url": "https://github.com/hakeemshah-tech/enterprise-rental-platform/issues"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "run-p --print-label dev:server dev:client",
    "dev:client": "npm run dev -w @rental/client",
    "dev:server": "npm run dev -w @rental/server",
    "build": "npm run build -w @rental/client",
    "start": "run-p --print-label start:server start:client",
    "start:client": "npm run start -w @rental/client",
    "start:server": "npm run start -w @rental/server",
    "lint": "npm run lint -w @rental/client",
    "typecheck": "npm run typecheck -w @rental/client",
    "test": "npm test -w @rental/server",
    "verify": "run-s lint typecheck test",
    "seed": "npm run seed -w @rental/server",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.3.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css,json,md,yml,yaml,mjs,cjs}": [
      "prettier --write"
    ]
  }
}
