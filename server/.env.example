# ──────────────────────────────────────────────────────────────
# Property API: Node.js/Express service
# Copy to `.env` and fill in. NEVER commit `.env`.
# Every value below is a placeholder; replace before running.
# ──────────────────────────────────────────────────────────────

# ── Runtime ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Data store ────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/rental_platform

# ── Auth ──────────────────────────────────────────────────────
JWT_SECRET=super_secret_key
JWT_EXPIRE=30d

# Credentials used by `npm run seed:admin`. Override before seeding
# any database that is not your local machine.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe@123

# ── Client / CORS ─────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
CLIENT_URL=http://localhost:3000

# ── Payments (Stripe) ─────────────────────────────────────────
# Leave both empty to run the built-in simulated-payment path.
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# ── Transactional email (Brevo notifications) ─────────────────
BREVO_API_KEY=xkeysib-placeholder
BREVO_SENDER_EMAIL=noreply@example.com
BREVO_SENDER_NAME=Enterprise Rental Platform
ADMIN_NOTIFICATION_EMAIL=admin@example.com

# Feature flags: both require a working BREVO_API_KEY.
ENABLE_EMAIL_VERIFICATION=false
ENABLE_EMAIL_NOTIFICATIONS=false
